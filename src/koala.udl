namespace koala {
    sequence<FileEntry> scan_ncm_folder(string source, string target);
    DecryptOutcome decrypt_ncm_file(string source_path, string output_dir);
    string audio_duration(string path);
};

// 扫描源目录后的一条待处理记录
dictionary FileEntry {
    u32 index;
    string source_path;
    string source_name;
    string output_name;
    string file_size;
    boolean already_exists;
    string music_length;
    string decrypt_date;
};

// 单个文件解密结果
dictionary DecryptOutcome {
    boolean success;
    string error_message;
    string output_name;
    string duration_text;
};
