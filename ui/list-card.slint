import { Card } from "card.slint";
import { RecordCard } from "record-card.slint";
import { ListView } from "std-widgets.slint";

export struct Record {
    id: int,
    source-name: string,
    output-name: string,
    file-size: string,
    decrypt-date: string,
    status: int,
    duration: string,
    music_length: string,
    error-message: string
}

export component ListCard inherits Rectangle {

    in property <[Record]> records;
    in property <bool> is-narrow: false;

    width: 100%;
    height: 100%;


    Card {
        width: 100%;
        height: 100%;
        title: "输出记录";
        compact: root.is-narrow;
        VerticalLayout {
            padding: root.is-narrow ? 8px : 12px;
            padding-right: root.is-narrow ? 8px : 20px;
            ListView {
                width: 100%;
                height: 100%;
                for record[index] in root.records: Rectangle {
                    width: 100%;
                    height: card.preferred-height + (root.is-narrow ? 6px : 8px);
                    card := RecordCard {
                        y: 0;
                        width: 100%;
                        height: card.preferred-height;
                        is-narrow: root.is-narrow;
                        source-name: record.source-name;
                        output-name: record.output-name;
                        file-size: record.file-size;
                        decrypt-date: record.decrypt-date;
                        status: record.status;
                        duration: record.duration;
                        music_length: record.music-length;
                        error-message: record.error-message;
                    }
                }
            }
        }
    }
}
