import { Card } from "card.slint";
import { RecordCard } from "record-card.slint";
import { ScrollView } from "std-widgets.slint";

export struct Record {
    id: int,
    source-name: string,
    output-name: string,
    file-size: string,
    decrypt-date: string,
    status: int,
    duration: string,
    music_length: string,
    error-message: string
}

export component ListCard inherits Rectangle {

    in property <[Record]> records;

    width: 100%;
    height: 100%;


    Card {
        width: 100%;
        height: 100%;
        title: "输出记录";
        ScrollView {
            width: 100%;
            height: 100%;
            vertical-stretch: 1;
            mouse-drag-pan-enabled: true;
            VerticalLayout {
                width: 100%;
                alignment: start;
                padding: 12px;
                padding-right: 20px; 
                spacing: 8px;
                for record in root.records: RecordCard {
                    width: 100%;
                    source-name: record.source-name;
                    output-name: record.output-name;
                    file-size: record.file-size;
                    decrypt-date: record.decrypt-date;
                    status: record.status;
                    duration: record.duration;
                    music_length: record.music-length;
                    error-message: record.error-message;
                }
            }
        }
    }
}
